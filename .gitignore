# 每台机器自己创建的环境和缓存
.venv/
.uv-cache/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# 构建产物和历史素材库不进入开发仓库；data/images/sound 是正式运行资源
/build/
/dist/
/release/
/assets/
/example/

# 本地私密配置、日志和临时文件
.env
.env.*
!.env.example
*.log
*.tmp
.DS_Store
Thumbs.db
.idea/

# 编辑器只共享必要配置
.vscode/*
!.vscode/settings.json

# 公开版不接收私人肖像、录音或美术预览
/images/generals/dingyichen/
/images/generals/zhangyiyan/
/sound/general/dingyichen/
/images/general_frames/previews/
